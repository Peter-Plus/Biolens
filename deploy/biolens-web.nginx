server {
    listen 80;
    server_name biolens.worldlinesite.com;
    location /.well-known/acme-challenge/ { root /var/www/biolens-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name biolens.worldlinesite.com;
    ssl_certificate /etc/letsencrypt/live/biolens.worldlinesite.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/biolens.worldlinesite.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    root /var/www/biolens;
    location = / { try_files /index.html =404; add_header Cache-Control "no-store"; }
    location /assets/ { try_files $uri =404; }
    location /web-api/ {
        client_max_body_size 101m;
        proxy_pass http://127.0.0.1:8938/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
    location / {
        proxy_pass http://127.0.0.1:8937;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
