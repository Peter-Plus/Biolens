{
  "name": "biolens",
  "version": "0.3.0",
  "private": true,
  "description": "BioLens biomedical analysis and visualization agent",
  "author": "BioLens",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/desktop.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node scripts/python.mjs -m pytest backend/tests -q",
    "backend": "node scripts/python.mjs -m biolens",
    "package:win": "npm run build && electron-builder --win --dir",
    "package:installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.biolens.desktop",
    "productName": "BioLens",
    "directories": {
      "output": "release/0.3.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/biolens",
        "to": "backend/biolens",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "runtime/python",
        "to": "python"
      },
      {
        "from": "examples",
        "to": "examples"
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronDist": "node_modules/electron/dist"
  }
}
